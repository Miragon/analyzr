<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written in the layout Camunda Modeler 5 writes for Camunda 7 (attribute order, two-space indentation, child order), for the amendment tests of M6 S5c-2; not saved from the Modeler. The golden *.amended.bpmn is what applyAmendments writes for the amendments of test/amend.test.ts. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0c7amnd" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="Process_Auftrag" name="Auftragsabwicklung" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Vom Auftragseingang bis zur Zahlung.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_1" name="Auftrag eingegangen">
      <bpmn:outgoing>Flow_0a1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="Call_Rechnung" name="Rechnung stellen" calledElement="Process_Rechnung">
      <bpmn:incoming>Flow_0a1</bpmn:incoming>
      <bpmn:outgoing>Flow_0a2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Versand" name="Versand beauftragen" calledElement="Process_Versand">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0a2</bpmn:incoming>
      <bpmn:outgoing>Flow_0a3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateThrowEvent id="Event_Bestaetigung" name="Bestätigung senden">
      <bpmn:incoming>Flow_0a3</bpmn:incoming>
      <bpmn:outgoing>Flow_0a4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0b1" camunda:expression="${mailer.send()}" messageRef="Message_9f890a6f" />
    </bpmn:intermediateThrowEvent>
    <bpmn:receiveTask id="Task_Zahlung" name="Zahlung abwarten" messageRef="Message_Zahlung">
      <bpmn:incoming>Flow_0a4</bpmn:incoming>
      <bpmn:outgoing>Flow_0a5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:callActivity id="Call_Fall" name="Reklamationsfall" camunda:caseRef="case-reklamation">
      <bpmn:incoming>Flow_0a5</bpmn:incoming>
      <bpmn:outgoing>Flow_0a6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_1" name="Auftrag abgeschlossen">
      <bpmn:incoming>Flow_0a6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0a1" sourceRef="StartEvent_1" targetRef="Call_Rechnung" />
    <bpmn:sequenceFlow id="Flow_0a2" sourceRef="Call_Rechnung" targetRef="Call_Versand" />
    <bpmn:sequenceFlow id="Flow_0a3" sourceRef="Call_Versand" targetRef="Event_Bestaetigung" />
    <bpmn:sequenceFlow id="Flow_0a4" sourceRef="Event_Bestaetigung" targetRef="Task_Zahlung" />
    <bpmn:sequenceFlow id="Flow_0a5" sourceRef="Task_Zahlung" targetRef="Call_Fall" />
    <bpmn:sequenceFlow id="Flow_0a6" sourceRef="Call_Fall" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmn:message id="Message_Zahlung" name="Zahlung eingegangen" />
  <bpmn:message id="Message_9f890a6f" name="Auftragsbestätigung" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Auftrag">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Rechnung_di" bpmnElement="Call_Rechnung">
        <dc:Bounds x="240" y="80" width="100" height="80" />
