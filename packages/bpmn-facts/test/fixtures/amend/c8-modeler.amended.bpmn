      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_C_di" bpmnElement="Call_C">
        <dc:Bounds x="540" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_D_di" bpmnElement="Call_D">
        <dc:Bounds x="690" y="80" width="100" height="80" />
