<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written in the layout Camunda Modeler 5 writes for Camunda 8 (attribute order, two-space indentation, child order), for the amendment tests of M6 S5c-2; not saved from the Modeler. The golden *.amended.bpmn is what applyAmendments writes for the amendments of test/amend.test.ts. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0c8amnd" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="Process_Lager" name="Wareneingang" isExecutable="true">
    <bpmn:documentation>Nimmt Lieferungen an&#10;und prüft sie.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_1" name="Lieferung eingetroffen">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="Call_A" name="Ohne Erweiterung">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_A" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_B" name="Mit Dokumentation">
      <bpmn:documentation>Prüft die Lieferung.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_B" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_C" name="Mit Ein- und Ausgaben">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=lieferung" target="lieferung" />
        </zeebe:ioMapping>
        <zeebe:calledElement processId="Process_C" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_D" name="Mit Ziel">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_D" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_E" name="Nicht verbunden">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_E" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:endEvent id="End_Meldung" name="Meldung senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="meldung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_e5cef131" />
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_1" name="Ohne Folge" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Call_A" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Call_A" targetRef="Call_B" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Call_B" targetRef="Call_C" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Call_C" targetRef="Call_D" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Call_D" targetRef="End_Meldung" />
  </bpmn:process>
  <bpmn:message id="Message_e5cef131" name="Wareneingang gemeldet" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Lager">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_A_di" bpmnElement="Call_A">
