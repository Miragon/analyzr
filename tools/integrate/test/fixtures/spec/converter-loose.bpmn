    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_s_t-pruefen" sourceRef="Event_s" targetRef="Activity_t-pruefen" />
    <bpmn:sequenceFlow id="Flow_t-einlagern_e" sourceRef="Activity_t-einlagern" targetRef="Event_e" />
    <bpmn:sequenceFlow id="Flow_t-pruefen_s" name="Nachlieferung" sourceRef="Activity_t-pruefen" targetRef="Event_s" />
    <bpmn:sequenceFlow id="Flow_t-pruefen_t-einlagern" sourceRef="Activity_t-pruefen" targetRef="Activity_t-einlagern" />
  </bpmn:process>
