<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_beispiel_collaboration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="analyzr-spec">
  <bpmn:collaboration id="Collaboration_beispiel_collaboration">
    <bpmn:participant id="Participant_p-versand" name="Versand" processRef="Process_p-versand" />
    <bpmn:participant id="Participant_p-vertrieb" name="Vertrieb" processRef="Process_p-vertrieb" />
    <bpmn:participant id="Participant_pool-kunde" name="Kunde" />
    <bpmn:messageFlow id="MessageFlow_pool-kunde_s1" name="Anfrage" sourceRef="Participant_pool-kunde" targetRef="Event_s1" />
    <bpmn:messageFlow id="MessageFlow_pool-kunde_t3" name="Auftrag" sourceRef="Participant_pool-kunde" targetRef="Activity_t3" />
    <bpmn:messageFlow id="MessageFlow_t2_pool-kunde" name="Angebot" sourceRef="Activity_t2" targetRef="Participant_pool-kunde" />
    <bpmn:messageFlow id="MessageFlow_t4_v-s" sourceRef="Activity_t4" targetRef="Event_v-s" />
    <bpmn:messageFlow id="MessageFlow_v-e_pool-kunde" name="Versandbestätigung" sourceRef="Event_v-e" targetRef="Participant_pool-kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Process_p-versand" name="Versand" isExecutable="false">
    <bpmn:task id="Activity_v-t" name="Ware versenden">
      <bpmn:incoming>Flow_v-s_v-t</bpmn:incoming>
      <bpmn:outgoing>Flow_v-t_v-e</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_v-e" name="Ware versandt">
      <bpmn:incoming>Flow_v-t_v-e</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_Versandbestaetigung" />
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_v-s" name="Versandauftrag erhalten">
      <bpmn:outgoing>Flow_v-s_v-t</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Versandauftrag" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_v-s_v-t" sourceRef="Event_v-s" targetRef="Activity_v-t" />
    <bpmn:sequenceFlow id="Flow_v-t_v-e" sourceRef="Activity_v-t" targetRef="Event_v-e" />
  </bpmn:process>
  <bpmn:process id="Process_p-vertrieb" name="Angebotserstellung" isExecutable="false">
    <bpmn:task id="Activity_t1" name="Angebot erstellen">
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_t2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Activity_t2" name="Angebot senden" messageRef="Message_Angebot">
      <bpmn:incoming>Flow_t1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_t3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_t3" name="Auftrag empfangen" messageRef="Message_Auftrag">
      <bpmn:incoming>Flow_t2_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_t4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Activity_t4" name="Auftrag an Versand übergeben" messageRef="Message_Versandauftrag">
      <bpmn:incoming>Flow_t3_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_e1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_e1" name="Auftrag angenommen">
      <bpmn:incoming>Flow_t4_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_s1" name="Anfrage eingegangen">
      <bpmn:outgoing>Flow_s1_t1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Kundenanfrage" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_s1_t1" sourceRef="Event_s1" targetRef="Activity_t1" />
    <bpmn:sequenceFlow id="Flow_t1_t2" sourceRef="Activity_t1" targetRef="Activity_t2" />
    <bpmn:sequenceFlow id="Flow_t2_t3" sourceRef="Activity_t2" targetRef="Activity_t3" />
    <bpmn:sequenceFlow id="Flow_t3_t4" sourceRef="Activity_t3" targetRef="Activity_t4" />
    <bpmn:sequenceFlow id="Flow_t4_e1" sourceRef="Activity_t4" targetRef="Event_e1" />
  </bpmn:process>
  <bpmn:message id="Message_Angebot" name="Angebot" />
