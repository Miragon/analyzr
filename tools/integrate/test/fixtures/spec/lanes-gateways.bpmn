<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_beispiel_lanes_gateways" targetNamespace="http://bpmn.io/schema/bpmn" exporter="analyzr-spec">
  <bpmn:collaboration id="Collaboration_beispiel_lanes_gateways">
    <bpmn:participant id="Participant_bestellung" name="Bestellung bearbeiten" processRef="Process_bestellung" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bestellung" name="Bestellung bearbeiten" isExecutable="false">
    <bpmn:documentation>Von der eingehenden Bestellung der Beispiel GmbH bis zur Benachrichtigung.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_bestellung">
      <bpmn:lane id="Lane_lane-einkauf" name="Einkauf">
        <bpmn:flowNodeRef>Activity_t-bestellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_e-storno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ev-frist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ev-lieferung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_g-warten</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_lane-lager" name="Lager">
        <bpmn:flowNodeRef>Activity_t-lager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_t-reservieren</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_lane-vertrieb" name="Vertrieb">
        <bpmn:flowNodeRef>Activity_t-kunde</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_t-nachfragen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_t-pruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_g-join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_g-oder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_g-oder-ende</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_g-ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_g-split</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="Activity_t-bestellen" name="Ware bestellen">
      <bpmn:incoming>Flow_g-split_t-bestellen</bpmn:incoming>
      <bpmn:outgoing>Flow_t-bestellen_g-join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Activity_t-kunde" name="Kunde informieren">
      <bpmn:incoming>Flow_g-oder_t-kunde</bpmn:incoming>
      <bpmn:outgoing>Flow_t-kunde_g-oder-ende</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Activity_t-lager" name="Lager informieren">
      <bpmn:incoming>Flow_g-oder_t-lager</bpmn:incoming>
      <bpmn:outgoing>Flow_t-lager_g-oder-ende</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="Activity_t-nachfragen" name="Angaben nachfordern">
      <bpmn:incoming>Flow_g-ok_t-nachfragen</bpmn:incoming>
      <bpmn:outgoing>Flow_t-nachfragen_t-pruefen</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_t-pruefen" name="Bestellung prüfen">
      <bpmn:incoming>Flow_s_t-pruefen</bpmn:incoming>
      <bpmn:incoming>Flow_t-nachfragen_t-pruefen</bpmn:incoming>
      <bpmn:outgoing>Flow_t-pruefen_g-ok</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_t-reservieren" name="Lagerplatz reservieren">
      <bpmn:incoming>Flow_g-split_t-reservieren</bpmn:incoming>
      <bpmn:outgoing>Flow_t-reservieren_g-join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_e" name="Bestellung abgeschlossen">
      <bpmn:incoming>Flow_g-oder-ende_e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_e-storno" name="Bestellung storniert">
      <bpmn:incoming>Flow_ev-frist_e-storno</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_ev-frist" name="Zwei Wochen vergangen">
      <bpmn:incoming>Flow_g-warten_ev-frist</bpmn:incoming>
      <bpmn:outgoing>Flow_ev-frist_e-storno</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_ev-lieferung" name="Lieferung eingetroffen">
      <bpmn:incoming>Flow_g-warten_ev-lieferung</bpmn:incoming>
      <bpmn:outgoing>Flow_ev-lieferung_g-oder</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="Event_s" name="Bestellung eingegangen">
      <bpmn:outgoing>Flow_s_t-pruefen</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_g-join">
      <bpmn:incoming>Flow_t-bestellen_g-join</bpmn:incoming>
      <bpmn:incoming>Flow_t-reservieren_g-join</bpmn:incoming>
      <bpmn:outgoing>Flow_g-join_g-warten</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:inclusiveGateway id="Gateway_g-oder" name="Wen benachrichtigen?">
      <bpmn:incoming>Flow_ev-lieferung_g-oder</bpmn:incoming>
      <bpmn:outgoing>Flow_g-oder_t-kunde</bpmn:outgoing>
      <bpmn:outgoing>Flow_g-oder_t-lager</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:inclusiveGateway id="Gateway_g-oder-ende">
      <bpmn:incoming>Flow_t-kunde_g-oder-ende</bpmn:incoming>
      <bpmn:incoming>Flow_t-lager_g-oder-ende</bpmn:incoming>
      <bpmn:outgoing>Flow_g-oder-ende_e</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_g-ok" name="Bestellung vollständig?">
      <bpmn:incoming>Flow_t-pruefen_g-ok</bpmn:incoming>
      <bpmn:outgoing>Flow_g-ok_g-split</bpmn:outgoing>
      <bpmn:outgoing>Flow_g-ok_t-nachfragen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_g-split">
      <bpmn:incoming>Flow_g-ok_g-split</bpmn:incoming>
      <bpmn:outgoing>Flow_g-split_t-bestellen</bpmn:outgoing>
      <bpmn:outgoing>Flow_g-split_t-reservieren</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:eventBasedGateway id="Gateway_g-warten" name="Lieferung?">
      <bpmn:incoming>Flow_g-join_g-warten</bpmn:incoming>
      <bpmn:outgoing>Flow_g-warten_ev-frist</bpmn:outgoing>
      <bpmn:outgoing>Flow_g-warten_ev-lieferung</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_ev-frist_e-storno" sourceRef="Event_ev-frist" targetRef="Event_e-storno" />
    <bpmn:sequenceFlow id="Flow_ev-lieferung_g-oder" sourceRef="Event_ev-lieferung" targetRef="Gateway_g-oder" />
    <bpmn:sequenceFlow id="Flow_g-join_g-warten" sourceRef="Gateway_g-join" targetRef="Gateway_g-warten" />
    <bpmn:sequenceFlow id="Flow_g-oder-ende_e" sourceRef="Gateway_g-oder-ende" targetRef="Event_e" />
    <bpmn:sequenceFlow id="Flow_g-oder_t-kunde" sourceRef="Gateway_g-oder" targetRef="Activity_t-kunde" />
    <bpmn:sequenceFlow id="Flow_g-oder_t-lager" sourceRef="Gateway_g-oder" targetRef="Activity_t-lager" />
    <bpmn:sequenceFlow id="Flow_g-ok_g-split" name="ja" sourceRef="Gateway_g-ok" targetRef="Gateway_g-split" />
    <bpmn:sequenceFlow id="Flow_g-ok_t-nachfragen" name="nein" sourceRef="Gateway_g-ok" targetRef="Activity_t-nachfragen" />
    <bpmn:sequenceFlow id="Flow_g-split_t-bestellen" sourceRef="Gateway_g-split" targetRef="Activity_t-bestellen" />
    <bpmn:sequenceFlow id="Flow_g-split_t-reservieren" sourceRef="Gateway_g-split" targetRef="Activity_t-reservieren" />
    <bpmn:sequenceFlow id="Flow_g-warten_ev-frist" sourceRef="Gateway_g-warten" targetRef="Event_ev-frist" />
    <bpmn:sequenceFlow id="Flow_g-warten_ev-lieferung" sourceRef="Gateway_g-warten" targetRef="Event_ev-lieferung" />
    <bpmn:sequenceFlow id="Flow_s_t-pruefen" sourceRef="Event_s" targetRef="Activity_t-pruefen" />
    <bpmn:sequenceFlow id="Flow_t-bestellen_g-join" sourceRef="Activity_t-bestellen" targetRef="Gateway_g-join" />
    <bpmn:sequenceFlow id="Flow_t-kunde_g-oder-ende" sourceRef="Activity_t-kunde" targetRef="Gateway_g-oder-ende" />
    <bpmn:sequenceFlow id="Flow_t-lager_g-oder-ende" sourceRef="Activity_t-lager" targetRef="Gateway_g-oder-ende" />
    <bpmn:sequenceFlow id="Flow_t-nachfragen_t-pruefen" sourceRef="Activity_t-nachfragen" targetRef="Activity_t-pruefen" />
    <bpmn:sequenceFlow id="Flow_t-pruefen_g-ok" sourceRef="Activity_t-pruefen" targetRef="Gateway_g-ok" />
    <bpmn:sequenceFlow id="Flow_t-reservieren_g-join" sourceRef="Activity_t-reservieren" targetRef="Gateway_g-join" />
  </bpmn:process>
