          <dc:Bounds x="173" y="185" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_c-bericht_ev-warten_di" bpmnElement="Flow_c-bericht_ev-warten">
        <di:waypoint x="876" y="160" />
        <di:waypoint x="936" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c-rechnungen_sp-belege_di" bpmnElement="Flow_c-rechnungen_sp-belege">
        <di:waypoint x="396" y="160" />
        <di:waypoint x="456" y="160" />
      </bpmndi:BPMNEdge>
