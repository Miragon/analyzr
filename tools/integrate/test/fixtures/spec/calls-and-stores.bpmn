<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_beispiel_calls_and_stores" targetNamespace="http://bpmn.io/schema/bpmn" exporter="analyzr-spec">
  <bpmn:process id="Process_abschluss" name="Monatsabschluss" isExecutable="false">
    <bpmn:subProcess id="Activity_c-bericht" name="Berichtswesen">
      <bpmn:documentation>Erstellt den Monatsbericht.</bpmn:documentation>
      <bpmn:incoming>Flow_t-buchen_c-bericht</bpmn:incoming>
      <bpmn:outgoing>Flow_c-bericht_ev-warten</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Activity_c-rechnungen" name="Rechnungen prüfen">
      <bpmn:incoming>Flow_s_c-rechnungen</bpmn:incoming>
      <bpmn:outgoing>Flow_c-rechnungen_sp-belege</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="Activity_sp-belege" name="Belege sammeln">
      <bpmn:incoming>Flow_c-rechnungen_sp-belege</bpmn:incoming>
      <bpmn:outgoing>Flow_sp-belege_t-buchen</bpmn:outgoing>
      <bpmn:property id="Property_sp-belege" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_sp-belege_ds-erp">
        <bpmn:sourceRef>DataStoreReference_ds-erp</bpmn:sourceRef>
        <bpmn:targetRef>Property_sp-belege</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:subProcess>
    <bpmn:serviceTask id="Activity_t-buchen" name="Buchungen übertragen">
      <bpmn:incoming>Flow_sp-belege_t-buchen</bpmn:incoming>
      <bpmn:outgoing>Flow_t-buchen_c-bericht</bpmn:outgoing>
      <bpmn:property id="Property_t-buchen" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_t-buchen_ds-erp">
        <bpmn:sourceRef>DataStoreReference_ds-erp</bpmn:sourceRef>
        <bpmn:targetRef>Property_t-buchen</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_t-buchen_ds-erp">
        <bpmn:targetRef>DataStoreReference_ds-erp</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_e" name="Abschluss fertig">
      <bpmn:incoming>Flow_ev-freigabe_e</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_ev-freigabe" name="Freigabe erteilt">
      <bpmn:incoming>Flow_ev-melden_ev-freigabe</bpmn:incoming>
      <bpmn:outgoing>Flow_ev-freigabe_e</bpmn:outgoing>
      <bpmn:signalEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Event_ev-melden" name="Abschluss melden">
      <bpmn:incoming>Flow_ev-warten_ev-melden</bpmn:incoming>
      <bpmn:outgoing>Flow_ev-melden_ev-freigabe</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_Monatsabschluss_beendet" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_ev-warten" name="Drei Tage warten">
      <bpmn:incoming>Flow_c-bericht_ev-warten</bpmn:incoming>
      <bpmn:outgoing>Flow_ev-warten_ev-melden</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="Event_s" name="Monatsabschluss gestartet">
      <bpmn:outgoing>Flow_s_c-rechnungen</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_Monatsabschluss" />
    </bpmn:startEvent>
    <bpmn:dataStoreReference id="DataStoreReference_ds-erp" name="ERP-System" />
    <bpmn:sequenceFlow id="Flow_c-bericht_ev-warten" sourceRef="Activity_c-bericht" targetRef="Event_ev-warten" />
    <bpmn:sequenceFlow id="Flow_c-rechnungen_sp-belege" sourceRef="Activity_c-rechnungen" targetRef="Activity_sp-belege" />
    <bpmn:sequenceFlow id="Flow_ev-freigabe_e" sourceRef="Event_ev-freigabe" targetRef="Event_e" />
    <bpmn:sequenceFlow id="Flow_ev-melden_ev-freigabe" sourceRef="Event_ev-melden" targetRef="Event_ev-freigabe" />
    <bpmn:sequenceFlow id="Flow_ev-warten_ev-melden" sourceRef="Event_ev-warten" targetRef="Event_ev-melden" />
    <bpmn:sequenceFlow id="Flow_s_c-rechnungen" sourceRef="Event_s" targetRef="Activity_c-rechnungen" />
    <bpmn:sequenceFlow id="Flow_sp-belege_t-buchen" sourceRef="Activity_sp-belege" targetRef="Activity_t-buchen" />
    <bpmn:sequenceFlow id="Flow_t-buchen_c-bericht" sourceRef="Activity_t-buchen" targetRef="Activity_c-bericht" />
  </bpmn:process>
  <bpmn:signal id="Signal_Monatsabschluss" name="Monatsabschluss" />
  <bpmn:signal id="Signal_Monatsabschluss_beendet" name="Monatsabschluss beendet" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_abschluss">
      <bpmndi:BPMNShape id="Activity_c-bericht_di" bpmnElement="Activity_c-bericht" isExpanded="false">
        <dc:Bounds x="776" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_c-rechnungen_di" bpmnElement="Activity_c-rechnungen" isExpanded="false">
        <dc:Bounds x="296" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_sp-belege_di" bpmnElement="Activity_sp-belege" isExpanded="false">
        <dc:Bounds x="456" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_t-buchen_di" bpmnElement="Activity_t-buchen">
        <dc:Bounds x="616" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStoreReference_ds-erp_di" bpmnElement="DataStoreReference_ds-erp">
