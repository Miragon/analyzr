        <bpmndi:BPMNLabel>
          <dc:Bounds x="1023" y="185" width="54" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ev-warten_di" bpmnElement="Event_ev-warten">
