{
  "name": "analyzr",
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "MIT",
  "description": "analyzr: a headless store for BPMN process landscapes (docs/CONCEPT.md)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/analyzr.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:candidates": "pnpm --filter @analyzr/eval-tools candidates",
    "eval:replay": "pnpm --filter @analyzr/eval-tools replay",
    "eval:live": "pnpm --filter @analyzr/eval-tools live",
    "eval:placements": "pnpm --filter @analyzr/eval-tools placements",
    "dev": "pnpm --parallel --filter @analyzr/server --filter @analyzr/web dev",
    "docker:up": "docker compose -p analyzr -f docker/compose.yaml up -d --build --wait",
    "db:up": "docker compose -p analyzr -f docker/compose.yaml up -d --wait db",
    "db:down": "docker compose -p analyzr -f docker/compose.yaml down",
    "db:migrate": "pnpm --filter @analyzr/server db:migrate",
    "seed": "node apps/cli/src/main.ts seed",
    "analyzr": "node apps/cli/src/main.ts",
    "agent-sim": "node apps/agent-sim/src/main.ts",
    "notices": "pnpm --filter @analyzr/notices generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
